# Run the Telegram gateway locally. Do not run two polling instances at once.
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
ISDALOG_API_URL=http://127.0.0.1:8000/api
LARAVEL_API_URL=http://127.0.0.1:8000/api
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2-vision:latest

# Shared server-only credential; use the same random value on bot and Laravel.
ISDALOG_BOT_SECRET=
