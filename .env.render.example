# Use these values in a Render Background Worker for the Telegram gateway.
# Set secrets in Render, never in Git.
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
ISDALOG_API_URL=https://YOUR-ISDALOG-WEB.onrender.com/api
LARAVEL_API_URL=https://YOUR-ISDALOG-WEB.onrender.com/api
GEMINI_API_KEY=

# Render cannot reach Ollama running on your personal computer. The current
# gateway will use Gemini when configured; otherwise it falls back to Ollama.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2-vision:latest

# Shared server-only credential; use the same random value on bot and Laravel.
ISDALOG_BOT_SECRET=
